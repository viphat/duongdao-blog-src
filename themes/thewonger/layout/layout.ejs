<!DOCTYPE html>
<html lang="vi">
  <head>
    <%
      var metaDescription = page.description || config.description || "Những ghi chép của gia đình Dương & Đào.";
      var pageTitle = page.title ? page.title + " | " + config.title : config.title;
      var pageUrl = page.permalink || full_url_for(page.path || "/");
      var posts = site.posts.sort("-date").toArray();
      var recentPosts = posts.slice(0, 6);
      var categories = site.categories.sort("name").toArray().filter(function(category) {
        return category.path.split("/").filter(Boolean).length === 2;
      });
      var analyticsConfig = config.analytics || {};
      var analyticsApiBase = analyticsConfig.api_base || "/api/analytics";
      var analyticsPath = page.path ? url_for(page.path) : url_for("/");
      var analyticsPageType = page.layout || "page";
      var commentsConfig = config.comments || {};
      var commentsApiBase = commentsConfig.api_base || "/api/comments";
    %>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta itemprop="description" name="description" content="<%= metaDescription %>" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:type" content="<%= page.layout === 'post' ? 'article' : 'website' %>" />
    <meta property="og:url" content="<%= pageUrl %>" />
    <meta property="og:image" content="<%- full_url_for('images/brand-card.svg') %>" />
    <meta property="og:description" content="<%= metaDescription %>" />
    <% if (page.date) { %>
      <meta property="article:published_time" content="<%= date(page.date, 'YYYY-MM-DD') %>" />
    <% } %>
    <meta property="og:title" content="<%= pageTitle %>" />
    <meta name="twitter:title" content="<%= pageTitle %>" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:description" content="<%= metaDescription %>" />
    <title><%= pageTitle %></title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      window.tailwind = window.tailwind || {};
      window.tailwind.config = {
        theme: {
          extend: {
            colors: {
              paper: "#f5f8f1",
              card: "#ffffff",
              ink: "#2b3a2a",
              muted: "#64735f",
              line: "#dde7d4",
              leaf: "#35714a",
              pine: "#29583b",
              moss: "#e9f1e0",
              cream: "#f8f4e7",
              berry: "#b04a4a",
              amber: "#b7791f"
            },
            fontFamily: {
              sans: ["Be Vietnam Pro", "Inter", "ui-sans-serif", "system-ui", "sans-serif"],
              display: ["Lora", "Georgia", "serif"],
              mono: ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "monospace"]
            },
            boxShadow: {
              lift: "0 16px 44px rgba(53, 113, 74, 0.10)",
              leafy: "0 8px 26px rgba(53, 113, 74, 0.12)"
            }
          }
        }
      };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&subset=vietnamese&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500;1,600&subset=vietnamese&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <%- css('css/style.css') %>
    <%- favicon_tag('images/favicon.png') %>
  </head>
  <body class="min-h-screen bg-paper text-ink antialiased" data-analytics-api="<%= analyticsApiBase %>" data-analytics-path="<%= analyticsPath %>" data-analytics-title="<%= page.title || config.title %>" data-analytics-page-type="<%= analyticsPageType %>" data-comments-api="<%= commentsApiBase %>">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-leaf focus:px-4 focus:py-3 focus:text-sm focus:font-semibold focus:text-white">
      Chuyển đến nội dung
    </a>

    <header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur">
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <%- partial('_partial/sprig', { className: "absolute -right-4 -top-6 h-20 w-32 rotate-180 opacity-45" }) %>
        <%- partial('_partial/sprig', { className: "absolute left-[38%] -top-8 hidden h-16 w-28 rotate-180 opacity-30 lg:block" }) %>
      </div>
      <div class="relative mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3.5 md:px-8">
        <a href="<%= url_for('/') %>" class="group inline-flex items-center gap-3 text-ink no-underline">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-moss ring-1 ring-line">
            <img src="<%- url_for('/images/kiwi-flaticon.png') %>" alt="Blog Dương Đào Family" class="h-8 w-8 object-contain" />
          </span>
          <span class="flex flex-col">
            <span class="font-display text-base font-semibold leading-5 md:text-lg">Dương &amp; Đào Family</span>
            <span class="hidden text-xs text-muted md:block">Nhật ký gia đình, học hỏi và những chuyến đi</span>
          </span>
        </a>

        <nav class="hidden items-center gap-1 md:flex" aria-label="Điều hướng chính">
          <a class="nav-link" href="<%= url_for('/') %>">Trang chủ</a>
          <a class="nav-link" href="<%= url_for('/categories') %>">Chuyên mục</a>
          <a class="nav-link" href="<%= url_for('/archives') %>">Lưu trữ</a>
        </nav>

        <button type="button" class="inline-flex h-11 items-center justify-center rounded-full border border-line bg-card px-4 text-sm font-semibold text-ink md:hidden" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu">
          Menu
        </button>
      </div>

      <div id="mobile-menu" class="hidden border-t border-line bg-paper md:hidden">
        <nav class="mx-auto flex max-w-6xl flex-col px-5 py-4" aria-label="Điều hướng di động">
          <a class="mobile-link" href="<%= url_for('/') %>">Trang chủ</a>
          <a class="mobile-link" href="<%= url_for('/categories') %>">Chuyên mục</a>
          <a class="mobile-link" href="<%= url_for('/archives') %>">Lưu trữ</a>
        </nav>
      </div>
    </header>

    <main id="main-content" class="mx-auto min-h-[70vh] max-w-6xl px-5 py-10 md:px-8 md:py-14">
      <%- body %>
    </main>

    <footer class="relative overflow-hidden border-t border-line bg-moss/70">
      <%- partial('_partial/sprig', { className: "pointer-events-none absolute -right-6 -top-8 h-36 w-52 opacity-50 md:h-44 md:w-64" }) %>
      <%- partial('_partial/sprig', { className: "pointer-events-none absolute -left-8 -top-6 hidden h-32 w-48 -scale-x-100 opacity-40 sm:block" }) %>
      <div class="relative mx-auto grid max-w-6xl gap-10 px-5 py-12 md:grid-cols-[1.2fr_1fr] md:px-8">
        <div>
          <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-leaf">
            <%- partial('_partial/leaf', { className: "h-4 w-4" }) %>
            Dương &amp; Đào Family
          </p>
          <p class="mt-3 max-w-xl text-sm leading-7 text-muted">
            Những điều đang học, những nơi đã đi qua, và vài kỷ niệm muốn giữ lại cho nhau.
          </p>
          <p class="mt-3 text-sm font-semibold text-muted" data-total-page-views aria-live="polite">
            Đang tải tổng lượt xem...
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            <% categories.slice(0, 8).forEach(function(category) { %>
              <a href="<%= url_for(category.path) %>" class="rounded-full border border-line bg-card px-4 py-2 text-xs font-semibold text-muted no-underline transition hover:border-leaf hover:text-leaf">
                <%= category.name %>
              </a>
            <% }); %>
          </div>
        </div>

        <div>
          <p class="font-display text-sm font-semibold uppercase tracking-wide text-muted">Mới nhất</p>
          <div class="mt-4 divide-y divide-line">
            <% recentPosts.slice(0, 4).forEach(function(post) { %>
              <a href="<%= post.permalink %>" class="group block py-3 no-underline">
                <span class="block text-sm font-semibold leading-6 text-ink transition group-hover:text-leaf"><%- post.title %></span>
                <span class="text-xs text-muted"><%= date(post.date, 'DD/MM/YYYY') %></span>
              </a>
            <% }); %>
          </div>
        </div>
        <p class="md:col-span-2 text-xs leading-6 text-muted">
          Kiwi icon by
          <a class="font-semibold text-muted underline underline-offset-2" href="https://www.flaticon.com/free-icon/kiwi_6498542" target="_blank" rel="noopener">Marz Gallery - Flaticon</a>.
        </p>
      </div>

      <div class="pointer-events-none relative mx-auto -mt-6 flex max-w-6xl items-end justify-between px-5 md:px-8" aria-hidden="true">
        <%- partial('_partial/tree', { className: "h-16 w-14 opacity-75" }) %>
        <%- partial('_partial/sprig', { className: "hidden h-10 w-16 opacity-60 sm:block" }) %>
        <%- partial('_partial/tree', { className: "h-24 w-20 opacity-90" }) %>
        <%- partial('_partial/sprig', { className: "hidden h-12 w-20 -scale-x-100 opacity-60 md:block" }) %>
        <%- partial('_partial/tree', { className: "hidden h-14 w-12 opacity-75 sm:block" }) %>
        <%- partial('_partial/tree', { className: "hidden h-20 w-16 opacity-85 lg:block" }) %>
      </div>
    </footer>

    <%- js('js/highlight.js') %>
    <%- js('js/mobile-nav.js') %>
    <%- js('js/analytics.js') %>
    <%- js('js/comments.js') %>
  </body>
</html>
