<%
  var pageCategories = page.categories ? page.categories.toArray() : [];
  var allPosts = site.posts.sort("-date").toArray();
  var morePosts = allPosts.filter(function(post) {
    return post.path !== page.path;
  }).slice(0, 3);
%>

<article class="mx-auto max-w-3xl">
  <header class="border-b border-line pb-8">
    <nav class="mb-8" aria-label="Đường dẫn">
      <a href="<%= url_for('/archives') %>" class="text-sm font-semibold text-leaf no-underline">Tất cả bài viết</a>
    </nav>

    <% if (pageCategories.length) { %>
      <div class="mb-5 flex flex-wrap gap-2">
        <% pageCategories.forEach(function(category) { %>
          <a href="<%= url_for(category.path) %>" class="rounded-lg border border-line px-3 py-2 text-xs font-semibold uppercase text-muted no-underline transition hover:border-leaf hover:text-leaf">
            <%= category.name %>
          </a>
        <% }); %>
      </div>
    <% } %>

    <h1 class="text-4xl font800 leading-tight text-ink md:text-5xl"><%= page.title %></h1>
    <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted">
      <% if (page.author) { %>
        <span><%= page.author %></span>
        <span aria-hidden="true">·</span>
      <% } %>
      <time datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'DD/MM/YYYY') %></time>
      <span aria-hidden="true">·</span>
      <span data-post-page-views aria-live="polite">Đang tải lượt xem...</span>
    </div>
  </header>

  <div class="content-prose mt-10">
    <%- page.content %>
  </div>

  <section class="comments-shell mt-14 border-t border-line pt-8" data-comments-section>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-2xl font800 leading-8 text-ink">Bình luận</h2>
        <p class="mt-2 text-sm leading-6 text-muted" data-comments-status>Đang tải bình luận...</p>
      </div>
      <button type="button" class="comments-author-button" data-comments-author-toggle>Chế độ tác giả</button>
    </div>

    <div class="comments-list mt-6" data-comments-list></div>

    <form class="comments-form mt-8" data-comments-form>
      <div class="comments-honeypot" aria-hidden="true">
        <label for="comment-website">Website</label>
        <input id="comment-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <label class="comments-label" for="comment-name">Tên của bạn</label>
      <input id="comment-name" class="comments-input" name="name" type="text" maxlength="80" autocomplete="name" required />

      <label class="comments-label mt-4" for="comment-body">Bình luận</label>
      <textarea id="comment-body" class="comments-textarea" name="body" maxlength="2000" rows="5" required></textarea>

      <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm leading-6 text-muted">Bình luận sẽ hiển thị sau khi tác giả duyệt.</p>
        <button type="submit" class="comments-submit">Gửi bình luận</button>
      </div>
    </form>
  </section>

  <% if (morePosts.length) { %>
    <aside class="mt-14 border-t border-line pt-8">
      <p class="text-sm font-semibold uppercase text-muted">Đọc tiếp</p>
      <div class="mt-4 divide-y divide-line">
        <% morePosts.forEach(function(post) { %>
          <a href="<%= post.permalink %>" class="group block py-4 no-underline">
            <h2 class="text-lg font700 leading-7 text-ink group-hover:text-leaf"><%- post.title %></h2>
            <p class="mt-1 text-sm text-muted"><%= date(post.date, 'DD/MM/YYYY') %></p>
          </a>
        <% }); %>
      </div>
    </aside>
  <% } %>
</article>
