<%
  var pageCategories = page.categories ? page.categories.toArray() : [];
  var allPosts = site.posts.sort("-date").toArray();
  var morePosts = allPosts.filter(function(post) {
    return post.path !== page.path;
  }).slice(0, 3);
%>

<article class="mx-auto max-w-3xl">
  <header class="border-b border-line pb-8">
    <nav class="mb-8" aria-label="Đường dẫn">
      <a href="<%= url_for('/archives') %>" class="text-sm font-semibold text-leaf no-underline">Tất cả bài viết</a>
    </nav>

    <% if (pageCategories.length) { %>
      <div class="mb-5 flex flex-wrap gap-2">
        <% pageCategories.forEach(function(category) { %>
          <a href="<%= url_for(category.path) %>" class="rounded-lg border border-line px-3 py-2 text-xs font-semibold uppercase text-muted no-underline transition hover:border-leaf hover:text-leaf">
            <%= category.name %>
          </a>
        <% }); %>
      </div>
    <% } %>

    <h1 class="text-4xl font800 leading-tight text-ink md:text-5xl"><%= page.title %></h1>
    <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted">
      <% if (page.author) { %>
        <span><%= page.author %></span>
        <span aria-hidden="true">·</span>
      <% } %>
      <time datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'DD/MM/YYYY') %></time>
    </div>
  </header>

  <div class="content-prose mt-10">
    <%- page.content %>
  </div>

  <% if (morePosts.length) { %>
    <aside class="mt-14 border-t border-line pt-8">
      <p class="text-sm font-semibold uppercase text-muted">Đọc tiếp</p>
      <div class="mt-4 divide-y divide-line">
        <% morePosts.forEach(function(post) { %>
          <a href="<%= post.permalink %>" class="group block py-4 no-underline">
            <h2 class="text-lg font700 leading-7 text-ink group-hover:text-leaf"><%- post.title %></h2>
            <p class="mt-1 text-sm text-muted"><%= date(post.date, 'DD/MM/YYYY') %></p>
          </a>
        <% }); %>
      </div>
    </aside>
  <% } %>
</article>
