<%
  var posts = page.posts ? page.posts.sort("-date").toArray() : [];

  function plainExcerpt(content, length) {
    if (!content) return "";
    var text = content
      .replace(/<script[\s\S]*?<\/script>/gi, "")
      .replace(/<style[\s\S]*?<\/style>/gi, "")
      .replace(/<[^>]*>/g, " ")
      .replace(/\s+/g, " ")
      .trim();
    return text.length > length ? text.substring(0, length).trim() + "..." : text;
  }

  function readingTime(content) {
    if (!content) return 1;
    var text = content
      .replace(/<[^>]*>/g, " ")
      .replace(/\s+/g, " ")
      .trim();
    var words = text ? text.split(" ").length : 0;
    return Math.max(1, Math.ceil(words / 220));
  }
%>

<section class="grid gap-10">
  <header class="max-w-3xl">
    <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-leaf">
      <%- partial('_partial/leaf', { className: "h-4 w-4" }) %>
      Chuyên mục
    </p>
    <h1 class="mt-4 font-display text-4xl font-semibold leading-tight text-ink md:text-5xl"><%= page.category %></h1>
    <p class="mt-5 text-base leading-8 text-muted"><%= posts.length %> bài viết trong chuyên mục này.</p>
  </header>

  <div class="grid gap-4">
    <% posts.forEach(function(post) { %>
      <article class="group rounded-[20px] border border-line bg-card shadow-sm transition hover:-translate-y-0.5 hover:border-leaf/40 hover:shadow-leafy">
        <a href="<%= post.permalink %>" class="grid gap-2 p-6 no-underline">
          <p class="flex flex-wrap items-center gap-x-2 text-xs text-muted">
            <time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'DD/MM/YYYY') %></time>
            <span aria-hidden="true">·</span>
            <span><%= readingTime(post.content) %> phút đọc</span>
            <% if (post.author) { %>
              <span aria-hidden="true">·</span>
              <span><%= post.author %></span>
            <% } %>
          </p>
          <h2 class="font-display text-xl font-semibold leading-8 text-ink transition group-hover:text-leaf"><%- post.title %></h2>
          <p class="text-sm leading-7 text-muted"><%= plainExcerpt(post.content, 220) %></p>
        </a>
      </article>
    <% }); %>
  </div>
</section>
