<%
  var posts = page.posts ? page.posts.sort("-date").toArray() : [];

  function plainExcerpt(content, length) {
    if (!content) return "";
    var text = content
      .replace(/<script[\s\S]*?<\/script>/gi, "")
      .replace(/<style[\s\S]*?<\/style>/gi, "")
      .replace(/<[^>]*>/g, " ")
      .replace(/\s+/g, " ")
      .trim();
    return text.length > length ? text.substring(0, length).trim() + "..." : text;
  }
%>

<section class="grid gap-10">
  <header class="max-w-3xl border-b border-line pb-8">
    <p class="text-sm font-semibold uppercase text-leaf">Chuyên mục</p>
    <h1 class="mt-4 text-4xl font800 leading-tight text-ink md:text-5xl"><%= page.category %></h1>
    <p class="mt-5 text-base leading-8 text-muted"><%= posts.length %> bài viết trong chuyên mục này.</p>
  </header>

  <div class="divide-y divide-line border-y border-line">
    <% posts.forEach(function(post) { %>
      <article>
        <a href="<%= post.permalink %>" class="group grid gap-3 py-6 no-underline md:grid-cols-[140px_minmax(0,1fr)]">
          <time class="text-sm text-muted" datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'DD/MM/YYYY') %></time>
          <div>
            <h2 class="text-xl font700 leading-8 text-ink group-hover:text-leaf"><%- post.title %></h2>
            <p class="mt-2 text-sm leading-7 text-muted"><%= plainExcerpt(post.content, 220) %></p>
            <% if (post.author) { %>
              <p class="mt-3 text-xs font-semibold uppercase text-muted"><%= post.author %></p>
            <% } %>
          </div>
        </a>
      </article>
    <% }); %>
  </div>
</section>
