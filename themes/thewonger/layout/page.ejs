<%
  var categoryCards = [
    {
      name: "Sống",
      path: "/categories/Song",
      image: "/images/ghi-voi.png",
      description: "Chuyên mục này tập hợp những dòng suy nghĩ, ý tưởng, tâm tư thoáng qua, được Phát và Vy ghi nhanh lại. Tiện cho việc nhìn lại chính mình hay tập hợp trở thành bài viết hoàn chỉnh vào một ngày đẹp trời."
    },
    {
      name: "Đi",
      path: "/categories/Di",
      image: "/images/di.png",
      description: "Nơi lưu lại những cuộc hành trình cùng nhau của Dương Đào Family."
    },
    {
      name: "Cảm",
      path: "/categories/Cam",
      image: "/images/cam-nghiem.png",
      description: "Mọi thứ mà chúng ta học, đọc, đi, làm, trải nghiệm trong đời sống này cuối cùng cũng để chiêm nghiệm ra một điều gì đó phục vụ lại cho cuộc sống của ta."
    },
    {
      name: "Cuộc sống ở Nhật",
      path: "/categories/Cuoc-song-o-Nhat",
      image: "/images/cuoc-song-o-nhat.jpg",
      description: "Chia sẻ mọi thứ mà chúng mình ghi lại về trải nghiệm của gia đình Dương Đào với cuộc sống tại Nhật."
    },
    {
      name: "Học",
      path: "/categories/Hoc",
      image: "/images/Phat-trien-ban-than.png",
      description: "Đọc, học, phát triển bản thân, công việc, tình yêu, tiền bạc, lối sống và những bước tiến chậm mà chắc."
    },
    {
      name: "Tiếng Nhật",
      path: "/categories/Tieng-Nhat",
      image: "/images/tieng-nhat.jpg",
      description: "Chia sẻ về những lượm lặt và tổng kết của chúng mình trên con đường chinh phục tiếng Nhật."
    },
    {
      name: "Viết",
      path: "/categories/Viet",
      image: "/images/Sang-tac.png",
      description: "Những sáng tác của Cô Đào và thuộc quyền sở hữu của Dương Đào Family."
    },
    {
      name: "Nghĩ",
      path: "/categories/Nghi",
      image: "/images/nghi.jpg",
      description: "Những tìm tòi, khám phá, học hỏi và tư duy về tài chính cá nhân, tư duy cầu tiến, hiệu suất."
    },
    {
      name: "Làm",
      path: "/categories/Lam",
      image: "/images/Lam.jpeg",
      description: "Trải nghiệm và góc nhìn về chuyện đi làm, phát triển bản thân trong cuộc sống và công việc."
    },
    {
      name: "Yêu",
      path: "/categories/Yeu",
      image: "/images/Mua-yeu.png",
      description: "Ký ức tuổi thơ, nỗi niềm thương nhớ về gia đình, và những người để lại trong mình nhiều kỷ niệm."
    },
    {
      name: "Kiwi cinema",
      path: "/categories/Kiwi-cinema",
      image: "/images/Kiwi-cinema.png",
      description: "Cùng xem phim và nghe nhạc chất lượng với Dương Đào Family."
    },
    {
      name: "Kiwi's Corner",
      path: "/categories/Kiwi-s-Corner/",
      image: "/images/Kiwi-corner.png",
      description: "Gọi là Kiwi's Corner vì mình vô tình tìm ra tên Dương Đào còn có ý nghĩa là trái Kiwi đó."
    }
  ];

  var isCategoriesPage = page.path && page.path.indexOf("categories/") === 0;
%>

<% if (isCategoriesPage) { %>
  <section class="grid gap-10">
    <header class="max-w-3xl">
      <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-leaf">
        <%- partial('_partial/leaf', { className: "h-4 w-4" }) %>
        Chuyên mục
      </p>
      <h1 class="mt-4 font-display text-4xl font-semibold leading-tight text-ink md:text-5xl">Đọc theo mạch riêng</h1>
      <p class="mt-5 text-base leading-8 text-muted">
        Mỗi chuyên mục là một góc nhỏ trong đời sống của gia đình Dương & Đào.
      </p>
    </header>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <% categoryCards.forEach(function(card) { %>
        <article class="group overflow-hidden rounded-[24px] border border-line bg-card shadow-sm transition hover:-translate-y-1 hover:border-leaf/40 hover:shadow-lift">
          <a href="<%= url_for(card.path) %>" class="block h-full text-ink no-underline">
            <img src="<%- url_for(card.image) %>" alt="<%= card.name %>" class="aspect-[16/10] w-full object-cover" loading="lazy" />
            <div class="p-6">
              <h2 class="font-display text-xl font-semibold leading-7 text-ink transition group-hover:text-leaf"><%= card.name %></h2>
              <p class="mt-3 text-sm leading-7 text-muted"><%= card.description %></p>
            </div>
          </a>
        </article>
      <% }); %>
    </div>
  </section>
<% } else { %>
  <article class="mx-auto max-w-3xl">
    <header>
      <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-leaf">
        <%- partial('_partial/leaf', { className: "h-4 w-4" }) %>
        Trang
      </p>
      <h1 class="mt-4 font-display text-4xl font-semibold leading-tight text-ink md:text-5xl"><%= page.title %></h1>
    </header>
    <div class="mt-8 rounded-[28px] border border-line bg-card p-6 shadow-leafy sm:p-8 md:p-10">
      <div class="content-prose">
        <%- page.content %>
      </div>
    </div>
  </article>
<% } %>
